{
  "name": "litfire",
  "version": "0.1.0",
  "description": "A LitRPG authoring tool: freeform writing, deterministic game state, contradictions recorded as open questions that never block.",
  "keywords": [
    "litrpg",
    "writing",
    "authoring",
    "tui",
    "ink",
    "obsidian",
    "markdown",
    "worldbuilding",
    "llm",
    "cli"
  ],
  "homepage": "https://github.com/claytantor/litfire#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/claytantor/litfire.git"
  },
  "bugs": {
    "url": "https://github.com/claytantor/litfire/issues"
  },
  "author": "claytantor",
  "license": "MIT",
  "type": "module",
  "bin": {
    "litfire": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx source/cli.tsx",
    "vault:new": "bash scripts/new-vault.sh",
    "build": "tsup && cp source/wiki/serve-script.mjs dist/serve-script.mjs",
    "start": "node dist/cli.js",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint source test",
    "lint:fix": "oxlint --fix source test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "check:secrets": "bash scripts/check-secrets.sh",
    "check:attribution": "bash scripts/check-attribution.sh",
    "hooks:install": "bash scripts/install-hooks.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "chokidar": "^5.0.0",
    "diff": "^9.0.0",
    "ink": "^7.1.1",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "isolated-vm": "^6.2.0",
    "marked": "^18.0.9",
    "meow": "^14.1.0",
    "react": "^19.2.8",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
